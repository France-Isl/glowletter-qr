<?xml version="1.0" encoding="utf-8"?>
<!-- Ночной синий фон виджета с тонкой золотой рамкой (как карточки в приложении). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/widget_night_deep"
        android:startColor="@color/widget_night" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_gold_line" />
</shape>
